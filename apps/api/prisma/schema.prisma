// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Policy {
  id            String          @id @db.Uuid
  companyId     String          @map("company_id") @db.Uuid
  name          String
  type          String
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  versions      PolicyVersion[]
  assignments   Assignment[]
  ledgerEntries LedgerEntry[]
  balances      Balance[]
  requests      TimeOffRequest[]

  @@unique([companyId, name])
  @@map("policies")
}

model PolicyVersion {
  id            String   @id @db.Uuid
  policyId      String   @map("policy_id") @db.Uuid
  versionNo     Int      @map("version_no")
  effectiveFrom DateTime @map("effective_from") @db.Date
  config        Json
  createdBy     String   @map("created_by")
  reason        String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  policy        Policy   @relation(fields: [policyId], references: [id])

  @@unique([policyId, versionNo])
  @@index([policyId, effectiveFrom(sort: Desc), versionNo(sort: Desc)])
  @@map("policy_versions")
}

model Assignment {
  id            String    @id @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  employeeId    String    @map("employee_id")
  policyId      String    @map("policy_id") @db.Uuid
  type          String
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  policy        Policy    @relation(fields: [policyId], references: [id])

  @@index([policyId, effectiveFrom])
  @@index([companyId, effectiveFrom])
  @@map("assignments")
}

model AuditEvent {
  id         String   @id @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  actorId    String   @map("actor_id")
  actorRole  String   @map("actor_role")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([companyId, entityType, entityId, createdAt(sort: Desc)])
  @@map("audit_events")
}

model LedgerEntry {
  id             String   @id @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  employeeId     String   @map("employee_id")
  policyId       String   @map("policy_id") @db.Uuid
  kind           String
  hours          Decimal  @db.Decimal(10, 4)
  occurredOn     DateTime @map("occurred_on") @db.Date
  period         String?
  idempotencyKey String   @map("idempotency_key")
  detail         Json?
  reason         String?
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  policy         Policy   @relation(fields: [policyId], references: [id])

  @@unique([companyId, idempotencyKey])
  @@index([companyId, employeeId, policyId, occurredOn(sort: Desc)])
  @@map("ledger_entries")
}

model Balance {
  employeeId String   @map("employee_id")
  policyId   String   @map("policy_id") @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  hours      Decimal  @default(0) @db.Decimal(10, 4)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  policy     Policy   @relation(fields: [policyId], references: [id])

  @@id([employeeId, policyId])
  @@index([companyId, employeeId])
  @@map("balances")
}

model TimeOffRequest {
  id             String    @id @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  employeeId     String    @map("employee_id")
  policyId       String    @map("policy_id") @db.Uuid
  type           String
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime  @map("end_date") @db.Date
  hours          Decimal   @db.Decimal(10, 4)
  status         String
  reason         String?
  idempotencyKey String    @map("idempotency_key")
  decidedBy      String?   @map("decided_by")
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz(3)
  decisionReason String?   @map("decision_reason")
  createdBy      String    @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  policy         Policy    @relation(fields: [policyId], references: [id])

  @@unique([companyId, idempotencyKey])
  @@index([companyId, status, createdAt(sort: Desc)])
  @@index([companyId, employeeId, startDate(sort: Desc)])
  @@map("time_off_requests")
}